# ============================================================
# 空手道場ナビ 環境変数サンプル
# このファイルをコピーして .env.local を作り、値を埋めてください。
#   cp .env.example .env.local
# .env.local は Git にコミットされません(.gitignore 済み)。
# 各キーの取得・再発行手順は docs/OPERATIONS.md を参照。
# ============================================================

# --- Supabase(データベース・ログイン・写真保存)-------------
# Supabase 管理画面 > Project Settings > API から取得
# NEXT_PUBLIC_ が付くものはブラウザに出ても安全な値です(RLSで保護)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側専用。絶対に公開・クライアントへ露出させないこと
SUPABASE_SERVICE_ROLE_KEY=

# --- サイトURL(canonical / OGP の生成に使用)---------------
# ローカル: http://localhost:3000 / 本番: https://本番ドメイン
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend(メール送信)------------------------------------
# サーバー側専用。フェーズ4で使用開始
RESEND_API_KEY=

# 通報・管理権限申請の通知先。カンマ区切りで複数指定可
ADMIN_NOTIFICATION_EMAIL=

# --- Sentry(エラー監視)------------------------------------
# 任意。未設定でもアプリは動作します(監視が無効になるだけ)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# ソースマップアップロード用。CI/Vercel のみに設定
SENTRY_AUTH_TOKEN=

# --- 定期処理(cron)の保護 ---------------------------------
# 十分に長いランダム文字列。フェーズ4以降で使用
CRON_SECRET=
